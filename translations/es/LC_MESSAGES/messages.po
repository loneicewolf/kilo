msgstr "Recargar la página"

#, python-format
msgid "%(num)d-day average"
msgid_plural "%(num)d-day average"
msgstr[0] "Promedio de %(num)d día"
msgstr[1] "Promedio de %(num)d días"

msgid "Overall average"
msgstr "Promedio global"

#, python-format
msgid "BMI (%(num)d-day avg): %(bmi)s"
