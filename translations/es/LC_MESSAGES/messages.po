msgid "Date"
msgstr "Fecha"

msgid "Weight (kg)"
msgstr "Peso (kg)"

msgid "Note"
msgstr "Nota"

#. Heading above the emoji the user picked most recently.
msgid "Recently used"
msgstr "Recientemente usados"

msgid "Loading more days…"
msgstr "Cargando más días…"

msgid "Log today's weight?"
msgstr "¿Registrar el peso de hoy?"

msgid "You haven't recorded a weight for today yet."
msgstr "Todavía no has registrado tu peso de hoy."

msgid "e.g. 82.4"
msgstr "p. ej., 82,4"

msgid "Skip"
msgstr "Omitir"

msgid "Unusual value"
msgstr "Valor inusual"

msgid "Correct it"
msgstr "Corregir"

msgid "Save anyway"
msgstr "Guardar de todos modos"

