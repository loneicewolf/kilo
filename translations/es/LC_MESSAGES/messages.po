#, python-format
msgid "Height: %(height)s"
msgstr "Altura: %(height)s"

msgid "Set your height"
msgstr "Indica tu altura"

#, python-format
msgid "Show the %(range)s chart"
msgstr "Mostrar el diagrama de %(range)s"

msgid "Show the whole history in the chart"
msgstr "Mostrar todo el historial en el diagrama"

#. Heading of the box about the logged weigh-ins: first date, last date and how
#. many.
msgid "Entries"
msgstr "Registros"

#. The date of the first entry.
msgid "First"
msgstr "Primero"

#. The date of the last (most recent) entry.
msgid "Last"
msgstr "Última"

#. The total number of entries.
msgid "Total"
msgstr "Total"

msgid "Daily log"
msgstr "Registro diario"

msgid "Scroll to the most recent entry"
msgstr "Ir al registro más reciente"

msgid "Most recent entry"
msgstr "Registro más reciente"

