msgstr[1] "%(num)d meses"

# machine-translated
#. NOTE: Screen-reader name of a chart range button such as 2W.
#, python-format
msgid "%(num)d week"
msgid_plural "%(num)d weeks"
msgstr[0] "%(num)d semana"
msgstr[1] "%(num)d semanas"

#, python-format
msgid "%(num)d-day change"
msgid_plural "%(num)d-day change"
msgstr[0] "Cambio en %(num)d día"
msgstr[1] "Cambio en %(num)d días"

msgid "Invalid date."
msgstr "Fecha inválida."

msgid "Invalid request."
msgstr "Solicitud inválida."

#, python-format
msgid ""
"%(weight)s is %(percent)s%% different from your entry of %(other)s on "
"%(date)s."
msgstr "%(weight)s difiere un %(percent)s%% de tu registro de %(other)s del %(date)s."

msgid "Enter a valid weight, like 72.5."
msgstr "Introduce un peso válido, por ejemplo 72,5."

#, python-format
msgid "Weight must be between %(min)s and %(max)s kg."
msgstr "El peso debe ser entre %(min)s y %(max)s kg."

msgid "Invalid range."
msgstr "Intervalo no válido."

msgid "Settings updated."
msgstr "Ajustes actualizados."

msgid "Your chart is now public."
msgstr "Tu diagrama ahora es público."

msgid "Your chart is no longer public."
msgstr "Tu diagrama ya no es público."

#, python-format
msgid "Imported %(num)d entry."
msgid_plural "Imported %(num)d entries."
msgstr[0] "%(num)d registro importado."
msgstr[1] "%(num)d registros importados."

#, python-format
msgid "Your height was set to %(height)s."
msgstr "Tu altura se ha establecido a %(height)s."

#, python-format
msgid "%(num)d note without a weight was skipped."
msgid_plural "%(num)d notes without a weight were skipped."
msgstr[0] "Se omitió %(num)d nota sin peso."
msgstr[1] "Se omitieron %(num)d notas sin peso."

#, python-format
msgid "%(details)s (+%(count)d more)"
msgstr "%(details)s (+%(count)d más)"

#, python-format
msgid "Skipped %(num)d invalid line: %(details)s"
msgid_plural "Skipped %(num)d invalid lines: %(details)s"
msgstr[0] "Se omitió %(num)d línea no válida: %(details)s"
msgstr[1] "Se omitieron %(num)d líneas no válidas: %(details)s"

msgid "No rows found in the file."
msgstr "No se encontraron filas en el archivo."

msgid "Back"
msgstr "Atrás"

msgid "About"
msgstr "Acerca de"

msgid "Back to the dashboard"
msgstr "Volver al panel"

msgid "About Kilo Tracker"
msgstr "Acerca de Kilo Tracker"

#, python-format
msgid ""
"For many years I tracked my weight with %(hdo_link)s, created by "
"%(walker_link)s. It kept working for a good while after his death, but in "
"March 2026 it finally stopped."
msgstr ""
"Durante muchos años seguí mi peso con %(hdo_link)s, creado por "
"%(walker_link)s. Siguió funcionando un buen tiempo después de su muerte, "
"pero en marzo de 2026 dejó de funcionar."

#, python-format
msgid ""
"I tried %(yadt_link)s as a replacement, but its interface wasn't for me. So "
"I vibe-coded my own version, and Kilo Tracker is the result. It's free for "
"anyone to use."
msgstr ""
"Probé %(yadt_link)s como sustituto, pero su interfaz no me convenció. Así "
"que programé mi propia versión con «vibe-coding», y Kilo Tracker es el "
"resultado. Es de uso gratis para todos."

#, python-format
msgid ""
"Kilo Tracker is open source software. You can download the source code and "
"run your own copy from %(github_link)s."
msgstr ""
"Kilo Tracker es software de código abierto. Puedes descargar el código "
"fuente y ejecutar tu propia copia desde %(github_link)s."

#, python-format
msgid "I hope you like it! You can reach me at %(mail_link)s."
msgstr "¡Espero que te guste! Puedes escribirme a %(mail_link)s."

#. Version of the app, with the date of its last change. %(version)s is a link
#. such as v1.2 or a commit id.
#, python-format
msgid "Version %(version)s &middot; committed %(date)s"
msgstr "Versión %(version)s &middot; commit del %(date)s"

#, python-format
msgid "Version %(version)s"
msgstr "Versión %(version)s"

# machine-translated
msgid "Video tutorial"
msgstr "Tutorial en vídeo"

# machine-translated
msgid ""
"A 13-minute video on YouTube shows how Kilo Tracker works, from signing in "
"to sharing your chart and taking your data with you."
msgstr ""
"Un vídeo de 13 minutos en YouTube muestra cómo funciona Kilo Tracker, desde "
"iniciar sesión hasta compartir tu gráfico y llevarte tus datos."

# machine-translated
msgid "Watch the Kilo Tracker video tutorial on YouTube"
msgstr "Ver el tutorial en vídeo de Kilo Tracker en YouTube"

msgid "How signing in works"
msgstr "Cómo funciona el inicio de sesión"

#, python-format
msgid ""
"There are no passwords. Enter your email and we send a 6-digit code that's "
"valid for %(num)s minute — enter it and you're signed in."
msgid_plural ""
"There are no passwords. Enter your email and we send a 6-digit code that's "
"valid for %(num)s minutes — enter it and you're signed in."
msgstr[0] ""
"No hay contraseñas. Introduce tu correo electrónico y te enviamos un código "
"de 6 dígitos válido durante %(num)s minuto: introdúcelo y habrás iniciado "
"sesión."
msgstr[1] ""
"No hay contraseñas. Introduce tu correo electrónico y te enviamos un código "
"de 6 dígitos válido durante %(num)s minutos: introdúcelo y habrás iniciado "
"sesión."

msgid "Gravatar uses"
msgstr "usa Gravatar"

#, python-format
msgid ""
"We never store your email address itself in our database. Instead we keep a "
"one-way SHA-256 hash of it (the same scheme %(gravatar_hash_link)s)."
msgstr ""
"Nunca guardamos tu dirección de correo electrónico en nuestra base de datos."
" En su lugar, conservamos un hash SHA-256 unidireccional (el mismo esquema "
"que %(gravatar_hash_link)s)."

#, python-format
msgid ""
"That hash also doubles as your Gravatar id — if you have an avatar set up at"
" %(gravatar_link)s, it shows up automatically once you're signed in."
msgstr ""
"Ese hash también sirve como tu id de Gravatar: si has configurado un avatar en"
" %(gravatar_link)s, aparece automáticamente al iniciar sesión."

msgid ""
"Kilo fetches that avatar from Gravatar itself and keeps a copy for a day, so"
" Gravatar never sees your visits, your browser or your IP address."
msgstr ""
"Kilo obtiene ese avatar de Gravatar y guarda una copia durante "
"un día, así que Gravatar nunca ve tus visitas, tu navegador ni tu dirección "
"IP."

#. Label of the menu that picks the language of the website.
msgid "Language"
msgstr "Idioma"

#. First choice in the language menu: follow the language set in the web
#. browser.
msgid "Browser language"
msgstr "Idioma del navegador"

msgid "OK"
msgstr "OK"

msgid "Signed in"
msgstr "Sesión iniciada"

msgid "Settings"
msgstr "Ajustes"

msgid "Log out"
msgstr "Cerrar sesión"

#. Heading of the page shown when the server had an unexpected error.
msgid "Something went wrong"
msgstr "Algo salió mal"

msgid "If you were saving something, check whether it was saved and try again."
msgstr "Si estabas guardando algo, comprueba si se guardó e inténtalo de nuevo."

msgid "Back to the start page"
msgstr "Volver a la página de inicio"

#. Title of the public page that shows someone's weight chart.
msgid "Weight chart"
msgstr "Diagrama de peso"

# machine-translated
#. Screen-reader label of the weight field of one day in the daily log;
#. %(date)s is a date such as 24 Oct 2026.
#, python-format
msgid "Weight on %(date)s"
msgstr "Peso del %(date)s"

# machine-translated
#. Screen-reader label of the note button of one day in the daily log; %(date)s
#. is a date such as 24 Oct 2026.
#, python-format
msgid "Note for %(date)s"
msgstr "Nota del %(date)s"

msgid "No note"
msgstr "Sin nota"

msgid "Add a note…"
msgstr "Añadir una nota…"

#. Tooltip and screen-reader label of the button that opens a panel of emoji to
#. put in a note.
msgid "Insert an emoji"
msgstr "Insertar un emoji"

msgid "Cancel"
msgstr "Cancelar"

#. Button that saves a note (verb).
#. Button that saves the settings (verb).
