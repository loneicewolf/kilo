msgid "You are now signed out on all other browsers and devices."
msgstr "Du är nu utloggad i alla andra webbläsare och enheter."


msgid "Download your data first."
msgstr "Ladda först ner din data."


msgid "Sign in again to confirm this request."
msgstr "Logga in igen för att bekräfta begäran."


#, python-format
msgid "We sent a confirmation code to %(email)s."
msgstr "Vi har skickat en bekräftelsekod till %(email)s."


msgid "Enter the 6-digit code."
msgstr "Ange den 6-siffriga koden."


msgid "That code has expired. Request a new one."
msgstr "Koden har gått ut. Begär en ny."


msgid "Too many attempts. Request a new code."
msgstr "För många försök. Begär en ny kod."


msgid "Incorrect code."
msgstr "Fel kod."


msgid "Your account and all your data have been removed."
msgstr "Ditt konto och all din data har tagits bort."


msgid "Enter your email to sign in."
msgstr "Ange din e-postadress för att logga in."


#, python-format
msgid "We sent a verification code to %(email)s."
msgstr "Vi har skickat en verifieringskod till %(email)s."


msgid "Enter your email to get a verification code."
msgstr "Ange din e-postadress för att få en verifieringskod."


msgid "Email verified  you're signed in."
msgstr "E-postadressen är verifierad – du är inloggad."


#, python-format
msgid "We sent a new code to %(email)s."
msgstr "Vi har skickat en ny kod till %(email)s."


msgid "Signed out."
msgstr "Du är utloggad."


#. NOTE: date,weight[,note] names the columns of a CSV line; translate the
#. names (note is optional).
#, python-format
msgid "line %(line)d: expected date,weight[,note]"
msgstr "rad %(line)d: förväntade datum,vikt[,anteckning]"


#, python-format
msgid "line %(line)d: invalid date %(value)s"
msgstr "rad %(line)d: ogiltigt datum %(value)s"


#, python-format
msgid "line %(line)d: invalid weight %(value)s"
msgstr "rad %(line)d: ogiltig vikt %(value)s"


#, python-format
msgid "line %(line)d: weight out of range"
msgstr "rad %(line)d: vikten är utanför intervallet"


#. NOTE: The email subject; the code is at the end, with no full stop, so it
#. can be copied.
#, python-format
msgid "Your verification code is %(code)s"
msgstr "Din verifieringskod är %(code)s"


#, python-format
msgid ""
"Your verification code is %(code)s.\n"
"\n"
"It expires in %(num)d minute. If you didn't request this, ignore this email."
msgid_plural ""
"Your verification code is %(code)s.\n"
"\n"
"It expires in %(num)d minutes. If you didn't request this, ignore this email."
msgstr[0] ""
"Din verifieringskod är %(code)s.\n"
"\n"
"Den upphör att gälla om %(num)d minut. Om du inte har begärt den kan du "
"ignorera det här e-postmeddelandet."
msgstr[1] ""
"Din verifieringskod är %(code)s.\n"
"\n"
"Den upphör att gälla om %(num)d minuter. Om du inte har begärt den kan du "
"ignorera det här e-postmeddelandet."


msgid "Confirm removal of your data"
msgstr "Bekräfta borttagning av dina data"


#, python-format
msgid ""
"Your confirmation code is %(code)s.\n"
"\n"
"Entering it will permanently delete your account and all your weight data. "
"It expires in %(num)d minute. If you didn't request this, ignore this email "
"and your data stays untouched."
msgid_plural ""
"Your confirmation code is %(code)s.\n"
"\n"
"Entering it will permanently delete your account and all your weight data. "
"It expires in %(num)d minutes. If you didn't request this, ignore this email"
" and your data stays untouched."
msgstr[0] ""
"Din bekräftelsekod är %(code)s.\n"
"\n"
"När du anger den raderas ditt konto och alla dina viktdata permanent. Den "
"upphör att gälla om %(num)d minut. Om du inte har begärt den kan du ignorera"
" det här e-postmeddelandet, så rörs inte dina data."
msgstr[1] ""
"Din bekräftelsekod är %(code)s.\n"
"\n"
"När du anger den raderas ditt konto och alla dina viktdata permanent. Den "
"upphör att gälla om %(num)d minuter. Om du inte har begärt den kan du "
"ignorera det här e-postmeddelandet, så rörs inte dina data."


msgid "That email domain doesn't accept mail (no MX record)."
msgstr "Den e-postdomänen tar inte emot e-post (ingen MX-post)."


msgid "Couldn't check that email domain right now. Try again."
msgstr "E-postdomänen kunde inte kontrolleras just nu. Försök igen."


msgid "Your session has expired. Reload the page and try again."
msgstr "Din session har gått ut. Ladda om sidan och försök igen."


msgid "Your session has expired and nothing was changed. Please try again."
msgstr "Din session har gått ut och ingenting ändrades. Försök igen."


msgid "That page isn't available, so you were taken to the start page."
msgstr "Sidan är inte tillgänglig, så du skickades till startsidan."


#, python-format
msgid ""
"The file is too large: the limit is %(size)s. Nothing was imported or "
"changed."
msgstr "Filen är för stor: gränsen är %(size)s. Inget har importerats eller ändrats."


msgid "Something went wrong on our side. Please try again in a moment."
msgstr "Något gick fel hos oss. Försök igen om en stund."


msgid "Email"
msgstr "E-postadress"


msgid "Verification code"
msgstr "Verifieringskod"


msgid "Enter the height as a plain number, e.g. 180 or 1.8."
msgstr "Ange längden som ett vanligt tal, t.ex. 180 eller 1,8."


#. NOTE: Label of the body height field in the settings.
msgid "Height"
msgstr "Längd"


msgid "Unit"
msgstr "Enhet"


msgid "Dark mode"
msgstr "Mörkt läge"


msgid "Moving average (days)"
msgstr "Glidande medelvärde (dagar)"


#, python-format
msgid ""
"Height must be between %(min_cm)s and %(max_cm)s cm (%(min_m)s and %(max_m)s"
" m)."
msgstr ""
"Längden måste vara mellan %(min_cm)s och %(max_cm)s cm (%(min_m)s och "
"%(max_m)s m)."


#. NOTE: Switch in the settings that makes the weight chart visible on a public
#. web page.
msgid "Share my chart on a public page"
msgstr "Dela mitt diagram på en offentlig sida"


#. NOTE: Switch in the settings: show the kilograms on the public chart, or
#. only the shape of the line.
msgid "Show my weight"
msgstr "Visa min vikt"


#. NOTE: Switch in the settings: show the boxes with the current average, BMI
#. and changes under the public chart.
msgid "Show the stat boxes on the public page"
msgstr "Visa statistikrutorna på den offentliga sidan"


#. NOTE: Label of the field with the last part of the public page's address
#. (the "ramon" in .../public/ramon).
msgid "Page ID"
msgstr "Sid-id"


#, python-format
msgid "Use %(min)d to %(max)d letters (a-z), digits, hyphens or underscores."
msgstr ""
"Använd %(min)d till %(max)d bokstäver (a-z), siffror, bindestreck eller "
"understreck."


msgid "That ID is already taken. Choose another one."
msgstr "Det id:t är redan upptaget. Välj ett annat."


msgid "CSV or XML file"
msgstr "CSV- eller XML-fil"


msgid "CSV, XML or text files only."
msgstr "Endast CSV-, XML- eller textfiler."


#, python-format
msgid "That file stores weights in %(unit)s, which can't be imported."
msgstr "Den filen sparar vikter i %(unit)s, vilket inte kan importeras."


msgid "That file isn't a valid Hacker's Diet XML export."
msgstr "Den filen är inte en giltig XML-export från Hacker's Diet."


#, python-format
msgid "%(date)s: invalid date"
msgstr "%(date)s: ogiltigt datum"


#, python-format
msgid "%(date)s: invalid weight %(value)s"
msgstr "%(date)s: ogiltig vikt %(value)s"


#, python-format
msgid "%(date)s: weight out of range"
msgstr "%(date)s: vikten är utanför intervallet"


#. NOTE: Rate of weight change. %(grams)s is a signed whole number; g is gram.
#, python-format
msgid "%(grams)s g/day"
msgstr "%(grams)s g/dag"


#. NOTE: Shown when too many sign-in codes were requested. %(num)d is a number
#. of minutes.
#, python-format
msgid "Too many requests. Try again in %(num)d minute."
msgid_plural "Too many requests. Try again in %(num)d minutes."
msgstr[0] "För många förfrågningar. Försök igen om %(num)d minut."
msgstr[1] "För många förfrågningar. Försök igen om %(num)d minuter."


#. NOTE: Chart range button: the whole recorded history.
msgid "All"
msgstr "Allt"


#. NOTE: Chart range button: 20 years. The letter is the unit, Y for year.
msgid "20Y"
msgstr "20Å"


#. NOTE: Chart range button: 15 years. The letter is the unit, Y for year.
msgid "15Y"
msgstr "15Å"


#. NOTE: Chart range button: 10 years. The letter is the unit, Y for year.
msgid "10Y"
msgstr "10Å"


#. NOTE: Chart range button: 5 years. The letter is the unit, Y for year.
msgid "5Y"
msgstr "5Å"


#. NOTE: Chart range button: 1 year. The letter is the unit, Y for year.
msgid "1Y"
msgstr "1Å"


#. NOTE: Chart range button: 6 months. The letter is the unit, M for month.
msgid "6M"
msgstr "6M"


#. NOTE: Chart range button: 3 months. The letter is the unit, M for month.
msgid "3M"
msgstr "3M"


#. NOTE: Chart range button: 1 month. The letter is the unit, M for month.
msgid "1M"
msgstr "1M"


#. NOTE: Chart range button: 2 weeks. The letter is the unit, W for week.
msgid "2W"
msgstr "2V"


#. NOTE: Chart range button: 1 week. The letter is the unit, W for week.
msgid "1W"
msgstr "1V"


#. NOTE: Screen-reader name of a chart range button such as 5Y.
#, python-format
msgid "%(num)d year"
msgid_plural "%(num)d years"
msgstr[0] "%(num)d år"
msgstr[1] "%(num)d år"


#. NOTE: Screen-reader name of a chart range button such as 3M.
#, python-format
msgid "%(num)d month"
msgid_plural "%(num)d months"
msgstr[0] "%(num)d månad"
msgstr[1] "%(num)d månader"


#. NOTE: Screen-reader name of a chart range button such as 2W.
#, python-format
msgid "%(num)d week"
msgid_plural "%(num)d weeks"
msgstr[0] "%(num)d vecka"
msgstr[1] "%(num)d veckor"


#, python-format
msgid "%(num)d-day change"
msgid_plural "%(num)d-day change"
msgstr[0] "Förändring på %(num)d dag"
msgstr[1] "Förändring på %(num)d dagar"


msgid "Invalid date."
msgstr "Ogiltigt datum."


msgid "Invalid request."
msgstr "Ogiltig begäran."


#, python-format
msgid ""
"%(weight)s is %(percent)s%% different from your entry of %(other)s on "
"%(date)s."
msgstr ""
"%(weight)s avviker med %(percent)s %% från din registrering på %(other)s den"
" %(date)s."


msgid "Enter a valid weight, like 72.5."
msgstr "Ange en giltig vikt, t.ex. 72,5."


#, python-format
msgid "Weight must be between %(min)s and %(max)s kg."
msgstr "Vikten måste vara mellan %(min)s och %(max)s kg."


msgid "Invalid range."
msgstr "Ogiltigt intervall."


msgid "Settings updated."
msgstr "Inställningarna har uppdaterats."


msgid "Your chart is now public."
msgstr "Ditt diagram är nu offentligt."


msgid "Your chart is no longer public."
msgstr "Ditt diagram är inte längre offentligt."


#, python-format
msgid "Imported %(num)d entry."
msgid_plural "Imported %(num)d entries."
msgstr[0] "%(num)d registrering importerades."
msgstr[1] "%(num)d registreringar importerades."


#, python-format
msgid "Your height was set to %(height)s."
msgstr "Din längd har ställts in på %(height)s."


#, python-format
msgid "%(num)d note without a weight was skipped."
msgid_plural "%(num)d notes without a weight were skipped."
msgstr[0] "%(num)d anteckning utan vikt hoppades över."
msgstr[1] "%(num)d anteckningar utan vikt hoppades över."


#, python-format
msgid "%(details)s (+%(count)d more)"
msgstr "%(details)s (+%(count)d till)"


#, python-format
msgid "Skipped %(num)d invalid line: %(details)s"
msgid_plural "Skipped %(num)d invalid lines: %(details)s"
msgstr[0] "%(num)d ogiltig rad hoppades över: %(details)s"
msgstr[1] "%(num)d ogiltiga rader hoppades över: %(details)s"


msgid "No rows found in the file."
msgstr "Inga rader hittades i filen."


msgid "Back"
msgstr "Tillbaka"


msgid "About"
msgstr "Om"


msgid "Back to the dashboard"
msgstr "Tillbaka till översikten"


msgid "About Kilo Tracker"
msgstr "Om Kilo Tracker"


#, python-format
msgid ""
"For many years I tracked my weight with %(hdo_link)s, created by "
"%(walker_link)s. It kept working for a good while after his death, but in "
"March 2026 it finally stopped."
msgstr ""
"I många år följde jag min vikt med %(hdo_link)s, skapat av %(walker_link)s. "
"Det fortsatte fungera länge efter hans död, men i mars 2026 slutade det till"
" sist."


#, python-format
msgid ""
"I tried %(yadt_link)s as a replacement, but its interface wasn't for me. So "
"I vibe-coded my own version, and Kilo Tracker is the result. It's free for "
"anyone to use."
msgstr ""
"Jag provade %(yadt_link)s som ersättare, men gränssnittet passade mig inte. "
"Så jag vibe-kodade min egen version, och Kilo Tracker är resultatet. Det är "
"gratis för alla."


#, python-format
msgid ""
"Kilo Tracker is open source software. You can download the source code and "
"run your own copy from %(github_link)s."
msgstr ""
"Kilo Tracker är programvara med öppen källkod. Du kan ladda ner källkoden "
"och köra din egen kopia från %(github_link)s."


#, python-format
msgid "I hope you like it! You can reach me at %(mail_link)s."
msgstr "Jag hoppas att du gillar den! Du når mig på %(mail_link)s."


#. Version of the app, with the date of its last change. %(version)s is a link
#. such as v1.2 or a commit id.
#, python-format
msgid "Version %(version)s &middot; committed %(date)s"
msgstr "Version %(version)s &middot; committad %(date)s"


#, python-format
msgid "Version %(version)s"
msgstr "Version %(version)s"


msgid "Video tutorial"
msgstr "Videoguide"


msgid ""
"A 13-minute video on YouTube shows how Kilo Tracker works, from signing in "
"to sharing your chart and taking your data with you."
msgstr ""
"En 13 minuter lång video på YouTube visar hur Kilo Tracker fungerar, från "
"inloggning till att dela ditt diagram och ta med dig dina data."


msgid "Watch the Kilo Tracker video tutorial on YouTube"
msgstr "Titta på videoguiden för Kilo Tracker på YouTube"


msgid "How signing in works"
msgstr "Så fungerar inloggningen"


#, python-format
msgid ""
"There are no passwords. Enter your email and we send a 6-digit code that's "
"valid for %(num)s minute - enter it and you're signed in."
msgid_plural ""
"There are no passwords. Enter your email and we send a 6-digit code that's "
"valid for %(num)s minutes - enter it and you're signed in."
msgstr[0] ""
"Det finns inga lösenord. Ange din e-postadress så skickar vi en sexsiffrig "
"kod som är giltig i %(num)s minut – ange den så är du inloggad."
msgstr[1] ""
"Det finns inga lösenord. Ange din e-postadress så skickar vi en sexsiffrig "
"kod som är giltig i %(num)s minuter – ange den så är du inloggad."


msgid "Gravatar uses"
msgstr "Gravatar"


#, python-format
msgid ""
"We never store your email address itself in our database. Instead we keep a "
"one-way SHA-256 hash of it (the same scheme %(gravatar_hash_link)s)."
msgstr ""
"Vi sparar aldrig själva din e-postadress i vår databas. I stället sparar vi "
"en enkelriktad SHA-256-hash av den (samma schema som %(gravatar_hash_link)s "
"använder)."


#, python-format
msgid ""
"That hash also doubles as your Gravatar id - if you have an avatar set up at"
" %(gravatar_link)s, it shows up automatically once you're signed in."
msgstr ""
"Den hashen fungerar också som ditt Gravatar-id – om du har ställt in en "
"avatar på %(gravatar_link)s visas den automatiskt när du är inloggad."


msgid ""
"Kilo fetches that avatar from Gravatar itself and keeps a copy for a day, so"
" Gravatar never sees your visits, your browser or your IP address."
msgstr ""
"Kilo hämtar själv avataren från Gravatar och sparar en kopia i ett dygn, så "
"Gravatar ser aldrig dina besök, din webbläsare eller din IP-adress."


#. Label of the menu that picks the language of the website.
msgid "Language"
msgstr "Språk"


#. First choice in the language menu: follow the language set in the web
#. browser.
msgid "Browser language"
msgstr "Webbläsarens språk"


msgid "OK"
msgstr "OK"


#. Link for keyboard users at the very top of every page; it jumps past the
#. header.
msgid "Skip to main content"
msgstr "Hoppa till huvudinnehållet"


msgid "Signed in"
msgstr "Inloggad"


msgid "Settings"
msgstr "Inställningar"


msgid "Log out"
msgstr "Logga ut"


#. Heading of the page shown when the server had an unexpected error.
msgid "Something went wrong"
msgstr "Något gick fel"


msgid "If you were saving something, check whether it was saved and try again."
msgstr "Om du höll på att spara något, kontrollera om det sparades och försök igen."


msgid "Back to the start page"
msgstr "Tillbaka till startsidan"


#. Title of the public page that shows someone's weight chart.
msgid "Weight chart"
msgstr "Viktdiagram"


#. Link for keyboard users at the top of the dashboard; it jumps past the chart
#. and the numbers to the list of days.
msgid "Skip to the daily log"
msgstr "Hoppa till dagloggen"


#. Screen-reader label of the weight field of one day in the daily log;
#. %(date)s is a date such as 24 Oct 2026.
#, python-format
msgid "Weight on %(date)s"
msgstr "Vikt den %(date)s"


#. Screen-reader label of the note button of one day in the daily log; %(date)s
#. is a date such as 24 Oct 2026.
#, python-format
msgid "Note for %(date)s"
msgstr "Anteckning för %(date)s"


msgid "No note"
msgstr "Ingen anteckning"


msgid "Add a note…"
msgstr "Lägg till en anteckning…"


#. Tooltip and screen-reader label of the button that opens a panel of emoji to
#. put in a note.
msgid "Insert an emoji"
msgstr "Infoga en emoji"


msgid "Cancel"
msgstr "Avbryt"


#. Button that saves a note (verb).
#. Button that saves the settings (verb).
msgid "Save"
msgstr "Spara"


#. Label above the latest moving-average weight.
msgid "Current average"
msgstr "Aktuellt medelvärde"


msgid "No entries yet."
msgstr "Inga registreringar ännu."


msgid "No entries yet - add your weight below."
msgstr "Inga registreringar än – lägg till din vikt nedan."


#. BMI is Body Mass Index; keep the abbreviation people know in your language.
msgid "BMI"
msgstr "BMI"


#. Third line of the BMI box: the body height in metres, for example "Height:
#. 1.86 m". %(height)s already includes the unit.
#, python-format
msgid "Height: %(height)s"
msgstr "Längd: %(height)s"


msgid "Set your height"
msgstr "Ange din längd"


#, python-format
msgid "Show the %(range)s chart"
msgstr "Visa diagrammet för %(range)s"


msgid "Show the whole history in the chart"
msgstr "Visa hela historiken i diagrammet"


#. Heading of the box about the logged weigh-ins: first date, last date and how
#. many.
msgid "Entries"
msgstr "Registreringar"


#. The date of the first entry.
msgid "First"
msgstr "Första"


#. The date of the last (most recent) entry.
msgid "Last"
msgstr "Senaste"


#. The total number of entries.
msgid "Total"
msgstr "Totalt"


msgid "Daily log"
msgstr "Daglogg"


msgid "Scroll to the most recent entry"
msgstr "Rulla till den senaste registreringen"


msgid "Most recent entry"
msgstr "Senaste registreringen"


#. Column headers of the daily log: the day, the weight in kilograms, and a
#. free-text note.
msgid "Date"
msgstr "Datum"


msgid "Weight (kg)"
msgstr "Vikt (kg)"


msgid "Note"
msgstr "Anteckning"


#. Heading above the emoji the user picked most recently.
msgid "Recently used"
msgstr "Nyligen använda"


msgid "Loading more days…"
msgstr "Läser in fler dagar…"


msgid "Log today's weight?"
msgstr "Registrera dagens vikt?"


msgid "You haven't recorded a weight for today yet."
msgstr "Du har inte registrerat någon vikt för i dag än."


msgid "e.g. 82.4"
msgstr "t.ex. 82,4"


msgid "Skip"
msgstr "Hoppa över"


msgid "Unusual value"
msgstr "Ovanligt värde"


msgid "Correct it"
msgstr "Rätta till"


msgid "Save anyway"
msgstr "Spara ändå"


#. Button that brings back a weight that was just deleted from the daily log.
msgid "Undo"
msgstr "Ångra"


#. Title of a dialog: the login session has timed out; the page must be
#. reloaded.
msgid "Session expired"
msgstr "Sessionen har gått ut"


#. Button that reloads the web page.
msgid "Reload page"
msgstr "Ladda om sidan"


#. Name of the whole period (the "All" range button) in the chart's description
#. for screen readers.
msgid "All weigh-ins"
msgstr "Alla vägningar"


#. The chart in words, for screen readers. %(period)s is a period such as "3
#. months"; the weights are such as "82.4 kg".
#, python-format
msgid ""
"%(period)s: from %(first)s on %(first_date)s to %(last)s on %(last_date)s. "
"Lowest %(lowest)s, highest %(highest)s, average %(average)s."
msgstr ""
"%(period)s: från %(first)s den %(first_date)s till %(last)s den "
"%(last_date)s. Lägsta %(lowest)s, högsta %(highest)s, medelvärde "
"%(average)s."


#. The chart in words, for screen readers, when the period shown has no
#. weights.
#, python-format
msgid "%(period)s: no weigh-ins in this period."
msgstr "%(period)s: inga vägningar under den här perioden."


#. The chart in words when the owner hides the weights on the public page: only
#. the line's direction.
#, python-format
msgid "%(period)s: the line ends lower than it starts."
msgstr "%(period)s: linjen slutar lägre än den börjar."


#. The chart in words when the owner hides the weights on the public page: only
#. the line's direction.
#, python-format
msgid "%(period)s: the line ends higher than it starts."
msgstr "%(period)s: linjen slutar högre än den börjar."


#. The chart in words when the owner hides the weights on the public page: only
#. the line's direction.
#, python-format
msgid "%(period)s: the line ends at the same height as it starts."
msgstr "%(period)s: linjen slutar på samma höjd som den börjar."


#, python-format
msgid "%(num)d-day average"
msgid_plural "%(num)d-day average"
msgstr[0] "Medelvärde över %(num)d dag"
msgstr[1] "Medelvärde över %(num)d dagar"


msgid "Overall average"
msgstr "Totalt medelvärde"


#, python-format
msgid "BMI (%(num)d-day avg): %(bmi)s"
msgid_plural "BMI (%(num)d-day avg): %(bmi)s"
msgstr[0] "BMI (medel över %(num)d dag): %(bmi)s"
msgstr[1] "BMI (medel över %(num)d dagar): %(bmi)s"


msgid "Saving…"
msgstr "Sparar…"


msgid "Saved"
msgstr "Sparat"


msgid "Could not save"
msgstr "Kunde inte spara"


msgid "Could not save."
msgstr "Kunde inte spara."


msgid "Error saving"
msgstr "Fel vid sparande"


#, python-format
msgid "Weight of %(date)s removed."
msgstr "Vikten för %(date)s har tagits bort."


msgid "Sign in"
msgstr "Logga in"


msgid "Enter your email and we'll send you a 6-digit code - no password needed."
msgstr ""
"Ange din e-postadress så skickar vi en sexsiffrig kod – inget lösenord "
"behövs."


msgid "Send code"
msgstr "Skicka kod"


msgid "How does this work?"
msgstr "Hur fungerar det?"


#. Shown at a public chart's address when there is no chart there, or its owner
#. stopped sharing it.
msgid "There is no public chart at this address (any more)."
msgstr "Det finns inget offentligt diagram (längre) på den här adressen."


msgid "Remove my data"
msgstr "Ta bort mina data"


msgid "Back to settings"
msgstr "Tillbaka till inställningar"


msgid ""
"This permanently deletes your account, all your weigh-ins and notes, and "
"your settings. It can't be undone."
msgstr ""
"Detta raderar permanent ditt konto, alla dina vägningar och anteckningar "
"samt dina inställningar. Det går inte att ångra."


msgid "Step 1: Download your data"
msgstr "Steg 1: Ladda ner dina data"


msgid "download it again"
msgstr "ladda ner dem igen"


#, python-format
msgid "Downloaded. You can %(again_link)s."
msgstr "Nedladdat. Du kan %(again_link)s."


msgid "Download a copy of your weigh-ins before they're deleted. This is required."
msgstr "Ladda ner en kopia av dina vägningar innan de raderas. Det är obligatoriskt."


msgid "Download my data (CSV)"
msgstr "Ladda ner mina data (CSV)"


msgid "I've downloaded it - continue"
msgstr "Jag har laddat ner dem – fortsätt"


msgid "Step 2: Confirm by email"
msgstr "Steg 2: Bekräfta via e-post"


#, python-format
msgid ""
"We sent a 6-digit code to <strong>%(email)s</strong>. It expires in %(num)s "
"minute."
msgid_plural ""
"We sent a 6-digit code to <strong>%(email)s</strong>. It expires in %(num)s "
"minutes."
msgstr[0] ""
"Vi har skickat en sexsiffrig kod till <strong>%(email)s</strong>. Den upphör"
" att gälla om %(num)s minut."
msgstr[1] ""
"Vi har skickat en sexsiffrig kod till <strong>%(email)s</strong>. Den upphör"
" att gälla om %(num)s minuter."


msgid "Delete everything"
msgstr "Radera allt"


msgid "Resend code"
msgstr "Skicka koden igen"


#, python-format
msgid "We'll email a confirmation code to <strong>%(email)s</strong>."
msgstr "Vi skickar en bekräftelsekod till <strong>%(email)s</strong>."


msgid "Send confirmation code"
msgstr "Skicka bekräftelsekod"


msgid "Your height is used to calculate your BMI."
msgstr "Din längd används för att beräkna ditt BMI."


#. Heading of the settings section about showing the weight chart on a public
#. web page.
msgid "Public chart"
msgstr "Offentligt diagram"


msgid ""
"Show your chart and stat boxes on a public page that anyone with the link "
"can see, and that you can embed in another website. Your notes, your email "
"address and your daily log are never shown."
msgstr ""
"Visa ditt diagram och dina statistikrutor på en offentlig sida som alla med "
"länken kan se, och som du kan bädda in på en annan webbplats. Dina "
"anteckningar, din e-postadress och din daglogg visas aldrig."


msgid ""
"Switched off, the chart shows only the shape of the line: no kilograms, no "
"BMI and no stat boxes."
msgstr ""
"Avstängt visar diagrammet bara linjens form: inga kilo, inget BMI och inga "
"statistikrutor."


#, python-format
msgid ""
"The last part of the page's address: %(min)d to %(max)d letters (a-z), "
"digits, hyphens or underscores. Leave it empty for a new random ID."
msgstr ""
"Den sista delen av sidans adress: %(min)d till %(max)d bokstäver (a-z), "
"siffror, bindestreck eller understreck. Lämna tomt för ett nytt slumpmässigt"
" id."


#. Label of a menu in the settings: which period the shared chart shows.
msgid "Chart range"
msgstr "Diagrammets period"


#. First choice of the chart range menu: the chart keeps its range buttons and
#. the visitor picks.
msgid "Visitor chooses (range buttons)"
msgstr "Besökaren väljer (periodknappar)"


msgid "Your public chart:"
msgstr "Ditt offentliga diagram:"


msgid "To show it in another website, put this code in that page's HTML:"
msgstr ""
"För att visa det på en annan webbplats, lägg in den här koden i den sidans "
"HTML:"


msgid "Import data"
msgstr "Importera data"


#. The text in <code> only names the three columns of a line such as
#. 23-9-26,79.7,text. Translate the names (date, weight, note): the file itself
#. has no header and is the same in every language.
msgid ""
"Import weigh-ins from a CSV text file. Each line is "
"<code>date,weight,note</code> (note is optional), for example:"
msgstr ""
"Importera vägningar från en CSV-textfil. Varje rad är "
"<code>datum,vikt,anteckning</code> (anteckningen är valfri), till exempel:"


#. Example notes in the CSV sample. The CSV format itself (dates, dot as
#. decimal separator) stays the same in every language.
msgid "optional notes"
msgstr "valfria anteckningar"


msgid "some text"
msgstr "lite text"


#. d-M-yy and d-M-yyyy describe the date pattern, as in 23-9-26 or 23-9-2026.
#. Use the first letter of the word for day, month (keep a capital M, so it
#. cannot be mistaken for minutes) and year in your language, e.g. j-M-aa in
#. French. The numbers in the file are always day-month-year.
msgid ""
"Dates are <code>d-M-yy</code> or <code>d-M-yyyy</code>; weight is in "
"kilograms. Importing a date that already has an entry overwrites it."
msgstr ""
"Datum har formen <code>d-M-åå</code> eller <code>d-M-åååå</code>; vikten "
"anges i kilogram. Om du importerar ett datum som redan har en registrering "
"skrivs den över."


#. "The Hacker's Diet Online" and "Yet Another Diet Tool" are names of web
#. services; do not translate them.
msgid ""
"You can also import the CSV or XML export of The Hacker's Diet Online, or "
"the CSV export of Yet Another Diet Tool. Weights, notes and, from the XML "
"file, your height are imported; everything else is ignored."
msgstr ""
"Du kan också importera CSV- eller XML-exporten från The Hacker's Diet Online"
" eller CSV-exporten från Yet Another Diet Tool. Vikter, anteckningar och, "
"från XML-filen, din längd importeras; allt annat ignoreras."


msgid "Import"
msgstr "Importera"


msgid "Export data"
msgstr "Exportera data"


msgid "Download all your weigh-ins as a CSV file (date, weight in kilograms, note)."
msgstr ""
"Ladda ner alla dina vägningar som en CSV-fil (datum, vikt i kilogram, "
"anteckning)."


msgid "Export CSV"
msgstr "Exportera CSV"


#. Heading of the settings section that ends the sign-in on every other browser
#. and device.
msgid "Sign out everywhere"
msgstr "Logga ut överallt"


msgid ""
"Signed in on a computer that isn't yours, or lost a phone? This signs you "
"out on every other browser and device. You stay signed in here."
msgstr ""
"Inloggad på en dator som inte är din, eller tappat bort en telefon? Det här "
"loggar ut dig i alla andra webbläsare och enheter. Du förblir inloggad här."


#. Button that ends the sign-in on all other browsers and devices (not on this
#. one).
msgid "Sign out on other devices"
msgstr "Logga ut på andra enheter"


msgid ""
"Permanently delete your account and all your weigh-ins. You'll be asked to "
"download your data and confirm with a code sent by email first."
msgstr ""
"Radera ditt konto och alla dina vägningar permanent. Du ombeds först ladda "
"ner dina data och bekräfta med en kod som skickas via e-post."


msgid "Remove my data…"
msgstr "Ta bort mina data…"


msgid "Sign up"
msgstr "Registrera dig"


msgid "Enter your email and we'll send you a 6-digit verification code."
msgstr "Ange din e-postadress så skickar vi en sexsiffrig verifieringskod."


msgid "Verify your email"
msgstr "Verifiera din e-postadress"


msgid "Enter your code"
msgstr "Ange din kod"


msgid "Verify"
msgstr "Verifiera"

